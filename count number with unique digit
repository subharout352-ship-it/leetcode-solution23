class Solution(object):

    def countNumbersWithUniqueDigits(self, n):
        """
        :type n: int
        :rtype: int
        """
        if n == 0:
            return 1

        n = min(n, 10)

        total = 10
        unique = 9
        available = 9

        for i in range(2, n + 1):
            unique *= available
            total += unique
            available -= 1

        return total
